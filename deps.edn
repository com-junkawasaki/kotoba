{:paths ["src" "resources"]
 :deps {org.clojure/data.json {:mvn/version "2.5.1"}
        ;; ADR-2607266000 Phase B: the datom model and the safe-subset grammar
        ;; gate moved out; the language repo consumes them instead of owning them.
        io.github.kotoba-lang/kgraph
        {:git/url "https://github.com/kotoba-lang/kgraph.git"
         :git/sha "c0cb9332c540e7205b78dff00b82b813097fbb9c"}
        io.github.kotoba-lang/grammar
        {:git/url "https://github.com/kotoba-lang/grammar.git"
         :git/sha "9a34c133a8fd840cc7cbf3af9f6732c73bf8afd5"}
        io.github.kotoba-lang/codebase
        {:git/url "https://github.com/kotoba-lang/codebase.git"
         :git/sha "b3964338fbf3819c32bb0db8016d7ec563abfe18"}
        io.github.kotoba-lang/security {:git/url "https://github.com/kotoba-lang/security.git"
                                        :git/sha "f409dbade106df076cefe640781b12db558f4135"}
        com.github.clj-easy/graal-build-time {:mvn/version "1.0.5"}
        org.clojure/clojurescript {:mvn/version "1.12.134"}
        org.clojure/tools.reader {:mvn/version "1.5.2"}
        ;; Canonical `.kotoba` frontend/KIR and restricted kotoba-script backend.
        io.github.kotoba-lang/compiler
        {:git/url "https://github.com/kotoba-lang/compiler.git"
         :git/sha "77093b8715f2429b671b91c54e84b6622cf17b9a"}
        ;; real git pins — the old :local/root ../../kotoba-lang/* paths (and the
        ;; bare kotoba-lang/ groups on the two contracts repos) resolved only
        ;; inside the west monorepo layout; a fresh standalone clone could not
        ;; even build a classpath (ADR-2607022800 Phase 4). Workspace-offline
        ;; dev against sibling checkouts: use the :dev alias.
        ;; bumped for ADR-2607140600 Phase 3a: kotoba-core-contracts@adb221f
        ;; registers motion/read+audio/io+ble/scan+wifi/info (capability ids
        ;; 234-237) and kotoba-lang@9c3f1b7 registers the matching
        ;; effect-for-kind entries -- both required for kotoba.runtime's new
        ;; op->kind entries below to resolve to real (not :unsupported-kind)
        ;; capabilities.
        ;; kotoba-lang bumped 2607131600 for kotoba-lang PR #16 (package
        ;; manifest signatures-error now does real Ed25519 verification
        ;; instead of shape-only checking; see test/fixtures/package/
        ;; positive-manifest.edn's updated signature below, which must be a
        ;; real signature under this pin or verify-lock now genuinely fails
        ;; it). org-chainagnostic-cacao bumped for PR #4 (nonce/replay
        ;; protection).
        ;; Includes the fs-write-atomic ABI descriptor required by the real
        ;; host-provider surface.  A newer incompatible pin left the provider
        ;; ahead of its contract and broke the launcher gate in CI.
        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git"
         :git/sha "2baa2c0f598ea7e9bcc394114780537ee37ed3ab"}
        io.github.kotoba-lang/kotoba-selfhost-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-selfhost-contracts.git"
         :git/sha "ea3bc8233720ad81ea0b6e2387e45dabc9231a7f"}
        io.github.kotoba-lang/kotoba-lang
        {:git/url "https://github.com/kotoba-lang/kotoba-lang.git"
         :git/sha "9c76285e7bae2137fefeb47966ac2e10eb71d1e4"}
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/org-chainagnostic-cacao.git"
         :git/sha "68fe618ddf2933035a78e68701cf632fdc18c4bf"}
        ;; canonical datom model — kotoba.kgraph (the language's in-mem EAVT view)
        ;; and kotobase (the datom database) share this one [e a v] / entity↔eavt
        ;; representation. kotoba : kotobase = Clojure : Datomic (ADR-2607032500).
        io.github.kotoba-lang/datom
        {:git/url "https://github.com/kotoba-lang/datom.git"
         :git/sha "d27a5833d59d909367956705f2ec931399c891ee"}
        ;; did:key/did:web document construction + local resolution
        ;; (kotoba.did-adapter, ADR-2607050100) — this library's first
        ;; consumer in the org.
        io.github.kotoba-lang/org-w3-did
        {:git/url "https://github.com/kotoba-lang/org-w3-did.git"
         :git/sha "f286e0a40739c6326a5af831efc224992d9ec159"}
        ;; pure-JVM WASM runtime (no native toolchain) — actually EXECUTES the
        ;; bytes runtime/wasm-binary emits (kotoba.wasm-exec), closing the
        ;; compile -> emit -> run loop instead of stopping at byte-shape checks.
        com.dylibso.chicory/wasm {:mvn/version "1.4.0"}
        com.dylibso.chicory/runtime {:mvn/version "1.4.0"}
        ;; real gen-keypair/sign/verify host-import implementations
        ;; (kotoba.wasm-exec/real-op-effects) -- same pin kotoba-lang/kototama's
        ;; tender.clj already uses for the identical algorithm choice.
        io.github.kotoba-lang/ed25519
        {:git/url "https://github.com/kotoba-lang/ed25519.git"
         :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}
        ;; org-chainagnostic-cacao still names the same upstream repository by
        ;; its historical artifact coordinate. Pin that coordinate too: a
        ;; legacy core.clj otherwise shadows the Graal-static core.cljc merely
        ;; because Clojure prefers .clj resources for the same namespace.
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/ed25519.git"
         :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}
        ;; real package manifest integrity verification
        ;; (kotoba.security.package-admission/manifest-integrity-error): canonical
        ;; DAG-CBOR encoding + CIDv1, matching kotoba-core-contracts'
        ;; package-contract cid? shape (kotoba-lang/kotoba-lang#13).
        io.github.kotoba-lang/dag-cbor
        {:git/url "https://github.com/kotoba-lang/dag-cbor.git"
         :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}
        ;; org-chainagnostic-cacao names the same CBOR repository by its IETF
        ;; coordinate. Pin both coordinates so an older cbor/core.cljc cannot
        ;; shadow the Graal-static canonical key comparator above.
        io.github.kotoba-lang/org-ietf-cbor
        {:git/url "https://github.com/kotoba-lang/dag-cbor.git"
         :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "310724803db65840f00d2d98d7887f2b6a512bd3"}
        ;; kotoba.value.v1 (ADR-kotoba-canonical-value-codec). VC5 lowers a
        ;; constant collection literal in host-argument position to the
        ;; canonical bytes of that value; the host decodes the same codec.
        ;; Already present transitively through codebase -- declared directly
        ;; because this repo now uses it in its own emit path.
        io.github.kotoba-lang/io-ipld
        {:git/url "https://github.com/kotoba-lang/io-ipld.git"
         :git/sha "e08dc3b2ab705be292e388cd1ad136381544a041"}}
 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}}
          :ns-default build}
  :dev {:override-deps {io.github.kotoba-lang/compiler {:local/root "../../kotoba-lang/compiler"}
                         io.github.kotoba-lang/security {:local/root "../security"}
                        io.github.kotoba-lang/codebase {:local/root "../codebase"}
                        io.github.kotoba-lang/kotoba-core-contracts {:local/root "../../kotoba-lang/kotoba-core-contracts"}
                        io.github.kotoba-lang/kotoba-selfhost-contracts {:local/root "../../kotoba-lang/kotoba-selfhost-contracts"}
                        io.github.kotoba-lang/kotoba-lang {:local/root "../../kotoba-lang/kotoba-lang"}
                        io.github.kotoba-lang/org-chainagnostic-cacao {:local/root "../../kotoba-lang/org-chainagnostic-cacao"}
                        io.github.kotoba-lang/datom {:local/root "../../kotoba-lang/datom"}
                        io.github.kotoba-lang/org-w3-did {:local/root "../../kotoba-lang/org-w3-did"}}}
  :test {:extra-paths ["test"]
         :main-opts ["-m" "kotoba.test-runner"]}
  :qualification {:extra-paths ["test"]
                  ;; Keep executable dependencies at the immutable repository
                  ;; pins above. Sibling checkouts are evidence inputs, not a
                  ;; reproducible runtime classpath for this report.
                  :main-opts ["-m" "kotoba.backend-qualification-test"]}
  ;; Cross-machine reproducibility of `wasm emit`: verify the checked-in
  ;; digests, or `regenerate` after an intended emitter change.
  :reproducible-emit {:main-opts ["-m" "kotoba.reproducible-emit"]}
  :grade-a-check {:main-opts ["-m" "kotoba.security.grade-a" "check"]}
  :grade-a-attest {:main-opts ["-m" "kotoba.security.grade-a" "attest"]}
  :crypto-check {:main-opts ["-m" "kotoba.security.crypto-qualification"]}
  :threat-model-check {:main-opts ["-m" "kotoba.security.threat-model"]}
  :supply-chain-check {:main-opts ["-m" "kotoba.security.supply-chain"]}
  :key-hierarchy-check {:main-opts ["-m" "kotoba.security.key-hierarchy"]}
  :control-adoption-check {:main-opts ["-m" "kotoba.security.control-adoption"]}
  :vulnerability-response-check
  {:main-opts ["-m" "kotoba.security.vulnerability-response"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.09.27"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}}}
