;; kbb.env — environment reads for kbb scripts. Wire id 33 (:env/read).
;; The host narrows by NAME against the policy's :env/read scope; a granted
;; name that is unset answers "" (same contract as the native loader's
;; env_read_provider: unset is not a trap). A name outside the scope is
;; refused by the host before getenv runs.
(ns kbb.env (:export [read present?]))

(defn read [name :string] :string
  (typed-cap-call :env/read :string :string name))

(defn present? [name :string] :bool
  (if (= (string-byte-length (read name)) 0) false true))
