{:adoption/version 3 :consumer/id :kotoba
 :security/git-sha "255b8fe79a5ffd5b087d8ce8f4d6108e5109195c"
 :required-control-namespaces
 [kotoba.security.abac kotoba.security.crypto-policy kotoba.security.information-flow
  kotoba.security.package-admission kotoba.security.release-evidence]
 ;; Must equal what source actually imports (adoption/source-security-inventory).
 ;; `kotoba.package-admission` was registered here after the namespace had moved
 ;; into the shared security package as `kotoba.security.package-admission`; the
 ;; entry was stale and `kotoba.launcher`, which imports it, was unregistered.
 ;; `kotoba.package-install` joined 2026-09-01. It requires
 ;; `kotoba.security.package-admission` and was never declared, so
 ;; `source-security-inventory` reported it as an unregistered importer and the
 ;; gate denied -- the same shape as the stale-entry note above, from the other
 ;; direction: there the declaration outlived the import, here the import
 ;; arrived without the declaration.
 :security-sensitive-entrypoints
 {kotoba.launcher [kotoba.security.package-admission kotoba.security.release-evidence]
  kotoba.package-install [kotoba.security.package-admission]
  kotoba.host-providers [kotoba.security.information-flow]
  kotoba.kagi-boundary [kotoba.security.information-flow]
  kotoba.runtime [kotoba.security.abac]}
 ;; Discovered by kotoba.security.adoption/source-sensitive-inventory, which
 ;; scans src/ for def/defn names matching its sensitive-name pattern. Each
 ;; entry names the shared control that owns its decision.
 :sensitive-operations
 {kotoba.kagi-boundary/secret-ref? [kotoba.security.information-flow]
  kotoba.kagi-boundary/secret-value-keys [kotoba.security.information-flow]
  kotoba.runtime/raw-memory-authorized? [kotoba.security.abac]}
 :exceptions []}
