;; demo_kbb_fs_read_native.kotoba — kbb --backend native wire-35 slice.
;; Reads ONE file through the loader's fs_app_data_read_provider: the guest
;; emits the typed-cap-call for :fs/app-data (wire id 35) directly (the
;; native backend does not lower the `fs-read` builtin the interpreter uses),
;; the artifact admits wire 35, the loader provider enforces the granted
;; scope (KEXE_CAP_RESOURCES_35) and returns the file bytes. Returns the
;; byte length of the read content as a proof the provider actually read it.
(ns demo-kbb-fs-read-native)

(defn main []
  (let [content (typed-cap-call :fs/app-data :string :string
                                "src/demo_kbb_fixture.txt")]
    (string-byte-length content)))