;; edn_pin_check.kotoba — kbb port wave 2 (ADR-2607181900): the deps.edn
;; git-pin audit UPGRADED from text-level to a real EDN-parsed scan.
;;
;; The wave-1 version (text-level) counted 40-hex runs after
;; "io.github.kotoba-lang/" with no EDN reader on the guest surface. Now
;; that data/edn (edn-read) + pure keys/get landed, this reads the deps.edn
;; from the fixture, edn-reads it into a real Clojure map, enumerates the
;; :deps entries via `keys`, and checks each dependency's :git/sha value is
;; a 40-hex string. A dependency with a non-map value (e.g. a :mvn/version
;; library) or a short sha is not a valid git pin and is not counted —
;; same verdict as the text-level scan, but structurally: no text-pattern
;; blind spots, and it would catch a sha that is 40 chars but NOT hex.
;;
;; Returns the count of 40-hex git pins; -1 on read/parse failure (fail
;; closed — an unparseable deps.edn is an error, not a silent 0).
;;
;; Language constraints (unchanged since verify_no_bb): no loop/recur —
;; iteration is fuel-bounded self-recursion; no seq/map over keys — walk
;; with `nth`, `count`, `get`, `keys` on the :deps map.
(ns edn-pin-check)

(defn hexc
  [c]
  (if (= c "0") 1
  (if (= c "1") 1
  (if (= c "2") 1
  (if (= c "3") 1
  (if (= c "4") 1
  (if (= c "5") 1
  (if (= c "6") 1
  (if (= c "7") 1
  (if (= c "8") 1
  (if (= c "9") 1
  (if (= c "a") 1
  (if (= c "b") 1
  (if (= c "c") 1
  (if (= c "d") 1
  (if (= c "e") 1
  (if (= c "f") 1
  0)))))))))))))))))

(defn hex?
  [s i n]
  (if (>= i n)
    1
    (if (= 1 (hexc (string-substring s i (+ i 1))))
      (hex? s (+ i 1) n)
      0)))

(defn valid-sha?
  [v]
  ;; nil (no :git/sha) or a non-40-length value is not a valid pin.
  ;; string-substring on nil would fail, so guard by length via count.
  (if (and (= 40 (count v)) (= 40 (string-length v)))
    (hex? v 0 40)
    0))

(defn deps-count
  [deps ks idx n acc]
  (if (< idx n)
    (let [key (nth ks idx)
          entry (get deps key)
          sha-chk (valid-sha? (get entry :git/sha))]
      (deps-count deps ks (+ idx 1) n (+ acc sha-chk)))
    acc))

(defn main []
  (let [raw (fs-read "test/fixtures/kbb_scripts/deps_sample.edn")]
    (if raw
      (let [m (edn-read raw)
            deps (:deps m)]
        (if deps
          (deps-count deps (keys deps) 0 (count deps) 0)
          -1))
      -1)))