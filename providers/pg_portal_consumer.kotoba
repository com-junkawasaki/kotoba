(ns kotoba.providers.pg-portal-consumer {:kotoba/raw-memory :checked-extents})

(defn ^:private portal-message-length
  [^{:kotoba/slice-len len :kotoba/slice-access :read} ptr len offset]
  (+ (* (slice-byte-at ptr len (+ offset 1)) 16777216)
     (* (slice-byte-at ptr len (+ offset 2)) 65536)
     (* (slice-byte-at ptr len (+ offset 3)) 256)
     (slice-byte-at ptr len (+ offset 4))))

(defn ^:private portal-count-tag
  [^{:kotoba/slice-len len :kotoba/slice-access :read} ptr len offset target count]
  (if (= offset len)
    count
    (if (> (+ offset 5) len)
      -1
      (let [total (+ (portal-message-length ptr len offset) 1)]
        (if (or (< total 5) (> (+ offset total) len))
          -1
          (portal-count-tag ptr len (+ offset total) target
                            (+ count (if (= (slice-byte-at ptr len offset) target)
                                       1 0))))))))

(defn ^:private portal-empty-params!
  [^{:kotoba/slice-len len :kotoba/slice-access :write} ptr len]
  (let [w0 (slice-byte-store! ptr len 0 0)
        w1 (slice-byte-store! ptr len 1 0)
        w2 (slice-byte-store! ptr len 2 0)
        w3 (slice-byte-store! ptr len 3 0)
        w4 (slice-byte-store! ptr len 4 0)
        w5 (slice-byte-store! ptr len 5 0)] 6))

(defn run [port]
  (let [channel (pg-open-scram-random
                 (str-ptr "localhost") (str-len "localhost") port
                 (str-ptr "kotoba") (str-len "kotoba")
                 (str-ptr "kotoba") (str-len "kotoba")
                 (str-ptr "db/primary") (str-len "db/primary"))]
    (let [out (alloc 2048)
          meta (alloc 7)
          params (alloc 6)
          params-len (portal-empty-params! params 6)
          prepared (pg-prepare channel
                               (str-ptr "series3") (str-len "series3")
                               (str-ptr "select generate_series(1,3)")
                               (str-len "select generate_series(1,3)")
                               out 2048 meta 7)
          begun (pg-query-state channel (str-ptr "BEGIN") (str-len "BEGIN")
                                out 2048 meta 7)
          bound (pg-bind-portal channel
                                (str-ptr "page") (str-len "page")
                                (str-ptr "series3") (str-len "series3")
                                params params-len out 2048 meta 7)
          first (pg-fetch-portal channel
                                 (str-ptr "page") (str-len "page") 2
                                 out 2048 meta 7)
          first-ok (if (and (> first 0)
                            (= (mem-byte-at meta 0) 0)
                            (= (mem-byte-at meta 1) 84)
                            (= (portal-count-tag
                                out (if (< first 0) 0
                                      (if (> first 2048) 2048 first)) 0 68 0) 2)
                            (= (portal-count-tag
                                out (if (< first 0) 0
                                      (if (> first 2048) 2048 first)) 0 115 0) 1)
                            (= (portal-count-tag
                                out (if (< first 0) 0
                                      (if (> first 2048) 2048 first)) 0 67 0) 0)) 1 0)
          second (pg-fetch-portal channel
                                  (str-ptr "page") (str-len "page") 2
                                  out 2048 meta 7)
          second-ok (if (and (> second 0)
                             (= (mem-byte-at meta 0) 0)
                             (= (mem-byte-at meta 1) 84)
                             (= (portal-count-tag
                                 out (if (< second 0) 0
                                       (if (> second 2048) 2048 second)) 0 68 0) 1)
                             (= (portal-count-tag
                                 out (if (< second 0) 0
                                       (if (> second 2048) 2048 second)) 0 115 0) 0)
                             (= (portal-count-tag
                                 out (if (< second 0) 0
                                       (if (> second 2048) 2048 second)) 0 67 0) 1)) 1 0)
          portal-closed (pg-close-portal channel
                                          (str-ptr "page") (str-len "page")
                                          out 2048 meta 7)
          committed (pg-query-state channel
                                    (str-ptr "COMMIT") (str-len "COMMIT")
                                    out 2048 meta 7)
          statement-closed (pg-close-statement
                            channel (str-ptr "series3") (str-len "series3")
                            out 2048 meta 7)
          channel-closed (pg-close-scram channel)]
      (if (and (> prepared 0) (> begun 0) (> bound 0)
               (= first-ok 1) (= second-ok 1) (> portal-closed 0)
               (> committed 0) (> statement-closed 0) (= channel-closed 0))
        1 0))))

(defn main [] 0)
