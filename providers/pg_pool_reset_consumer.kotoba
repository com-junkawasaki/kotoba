(ns kotoba.providers.pg-pool-reset-consumer {:kotoba/raw-memory :checked-extents})

(defn ^:private reset-message-length
  [^{:kotoba/slice-len len :kotoba/slice-access :read} ptr len offset]
  (+ (* (slice-byte-at ptr len (+ offset 1)) 16777216)
     (* (slice-byte-at ptr len (+ offset 2)) 65536)
     (* (slice-byte-at ptr len (+ offset 3)) 256)
     (slice-byte-at ptr len (+ offset 4))))

(defn ^:private reset-find-tag
  [^{:kotoba/slice-len len :kotoba/slice-access :read} ptr len offset target]
  (if (> (+ offset 5) len)
    -1
    (let [total (+ (reset-message-length ptr len offset) 1)]
      (if (or (< total 5) (> (+ offset total) len))
        -1
        (if (= (slice-byte-at ptr len offset) target)
          offset
          (reset-find-tag ptr len (+ offset total) target))))))

(defn ^:private reset-row-empty?
  [^{:kotoba/slice-len len :kotoba/slice-access :read} ptr len]
  (let [row (reset-find-tag ptr len 0 68)]
    (if (and (>= row 0) (<= (+ row 11) len)
             (= (slice-byte-at ptr len (+ row 5)) 0)
             (= (slice-byte-at ptr len (+ row 6)) 1)
             (= (slice-byte-at ptr len (+ row 7)) 0)
             (= (slice-byte-at ptr len (+ row 8)) 0)
             (= (slice-byte-at ptr len (+ row 9)) 0)
             (= (slice-byte-at ptr len (+ row 10)) 0)) 1 0)))

(defn ^:private reset-row-is-byte?
  [^{:kotoba/slice-len len :kotoba/slice-access :read} ptr len expected]
  (let [row (reset-find-tag ptr len 0 68)]
    (if (and (>= row 0) (<= (+ row 12) len)
             (= (slice-byte-at ptr len (+ row 5)) 0)
             (= (slice-byte-at ptr len (+ row 6)) 1)
             (= (slice-byte-at ptr len (+ row 7)) 0)
             (= (slice-byte-at ptr len (+ row 8)) 0)
             (= (slice-byte-at ptr len (+ row 9)) 0)
             (= (slice-byte-at ptr len (+ row 10)) 1)
             (= (slice-byte-at ptr len (+ row 11)) expected)) 1 0)))

(defn ^:private reset-empty-params!
  [^{:kotoba/slice-len len :kotoba/slice-access :write} ptr len]
  (let [w0 (slice-byte-store! ptr len 0 0)
        w1 (slice-byte-store! ptr len 1 0)
        w2 (slice-byte-store! ptr len 2 0)
        w3 (slice-byte-store! ptr len 3 0)
        w4 (slice-byte-store! ptr len 4 0)
        w5 (slice-byte-store! ptr len 5 0)] 6))

(defn run [port]
  (let [channel (pg-open-scram-random
                 (str-ptr "localhost") (str-len "localhost") port
                 (str-ptr "kotoba") (str-len "kotoba")
                 (str-ptr "kotoba") (str-len "kotoba")
                 (str-ptr "db/primary") (str-len "db/primary"))]
    (let [out (alloc 4096)
          meta (alloc 7)
          set-name (pg-query-state
                    channel (str-ptr "set application_name = 'dirty-lease'")
                    (str-len "set application_name = 'dirty-lease'")
                    out 4096 meta 7)
          temporary (pg-query-state
                     channel (str-ptr "create temporary table pool_dirty(v int4)")
                     (str-len "create temporary table pool_dirty(v int4)")
                     out 4096 meta 7)
          prepared (pg-prepare channel
                               (str-ptr "dirty_stmt") (str-len "dirty_stmt")
                               (str-ptr "select 99") (str-len "select 99")
                               out 4096 meta 7)
          begun (pg-query-state channel (str-ptr "BEGIN") (str-len "BEGIN")
                                out 4096 meta 7)
          inserted (pg-query-state
                    channel (str-ptr "insert into pool_dirty values (7)")
                    (str-len "insert into pool_dirty values (7)")
                    out 4096 meta 7)
          reset (pg-session-reset channel out 4096 meta 7)
          shown (pg-query-state
                 channel (str-ptr "show application_name")
                 (str-len "show application_name") out 4096 meta 7)
          name-reset (reset-row-empty?
                      out (if (< shown 0) 0 (if (> shown 4096) 4096 shown)))
          temp-check (pg-query-state
                      channel
                      (str-ptr "select to_regclass('pg_temp.pool_dirty') is null")
                      (str-len "select to_regclass('pg_temp.pool_dirty') is null")
                      out 4096 meta 7)
          temp-reset (reset-row-is-byte?
                      out (if (< temp-check 0) 0
                            (if (> temp-check 4096) 4096 temp-check)) 116)
          params (alloc 6)
          params-len (reset-empty-params! params 6)
          missing-statement (pg-execute-params
                             channel (str-ptr "dirty_stmt") (str-len "dirty_stmt")
                             params params-len out 4096 meta 7)
          deallocated (if (and (> missing-statement 0)
                               (= (mem-byte-at meta 0) 1)
                               (= (mem-byte-at meta 1) 73)
                               (= (mem-byte-at meta 2) 50)
                               (= (mem-byte-at meta 3) 54)
                               (= (mem-byte-at meta 4) 48)
                               (= (mem-byte-at meta 5) 48)
                               (= (mem-byte-at meta 6) 48)) 1 0)
          reused (pg-query-state channel (str-ptr "select 42") (str-len "select 42")
                                 out 4096 meta 7)
          reuse-ok (if (and (> reused 0) (= (mem-byte-at meta 0) 0)
                            (= (mem-byte-at meta 1) 73)) 1 0)
          closed (pg-close-scram channel)]
      (if (and (> set-name 0) (> temporary 0) (> prepared 0)
               (> begun 0) (> inserted 0) (> reset 0)
               (= name-reset 1) (= temp-reset 1) (= deallocated 1)
               (= reuse-ok 1) (= closed 0)) 1 0))))

(defn main [] 0)
