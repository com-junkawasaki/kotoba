;; examples/kbb/shebang_scan.kotoba — the interpreter gate script
;; src/shebang_scan.kotoba (verify-no-babashka's shebang arm: per-file class
;; bb-shebang / other-shebang / no-shebang) ported to the COMPILE route
;; through the kbb library. Same fixtures, same policy, same classes.
;;
;; The interpreter twin answers a 3-vector [bb other none]; a compiled main
;; answers ONE i64, so the three counts are packed as bb*100 + other*10 +
;; none (each count < 10 for the fixture dir). [1 2 2] <-> 122. The test
;; unpacks it and compares against the interpreter's vector. The listing is
;; walked by index with kbb.str/line-count + nth-line; the prefix test is
;; kbb.str/starts-with?.
(ns examples.kbb.shebang-scan
  (:require [kbb.fs :as fs] [kbb.browse :as browse] [kbb.str :as str])
  (:export [main]))

(defn classify [content :string] :i64
  (if (str/starts-with? content "#!/usr/bin/env bb")
    100
    (if (str/starts-with? content "#!") 10 1)))

(defn scan-entries [dir :string listing :string i :i64 acc :i64] :i64
  (if (>= i (str/line-count listing))
    acc
    (scan-entries dir listing (+ i 1)
                  (+ acc (classify (fs/read-file (string-concat (string-concat dir "/")
                                                                (str/nth-line listing i))))))))

(defn main [] :i64
  (scan-entries "test/fixtures/kbb_gate_scripts/shebang_dir"
                (browse/entries "test/fixtures/kbb_gate_scripts/shebang_dir")
                0 0))
