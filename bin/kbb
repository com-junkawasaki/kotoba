#!/usr/bin/env sh
set -eu

PRG="$0"
while [ -L "$PRG" ]; do
  LINK=$(readlink "$PRG")
  case "$LINK" in
    /*) PRG="$LINK" ;;
    *) PRG="$(dirname -- "$PRG")/$LINK" ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)
KBB_HOME=${KBB_HOME:-"$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"}

# kbb v2 (JVM-free): nbb shim — amu compile --jvm-free + kexe_loader execution
# for the native provider surface (fs/app-data, wire 35). --backend interpreter
# delegates to the JVM kotoba.kbb.
exec nbb "$SCRIPT_DIR/kbb_shim.cljs" "$@"